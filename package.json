{
  "name": "foodgaurd",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "dev:https": "next dev --webpack -H 0.0.0.0 -p 3000 --experimental-https --experimental-https-key ./certificates/dev-key.pem --experimental-https-cert ./certificates/dev-cert.pem",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:import-fssai": "tsx scripts/import-fssai.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.7",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/client": "^6.8.0",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "ioredis": "^5.4.2",
    "jose": "^6.0.8",
    "lucide-react": "^0.563.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.0",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^6.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.1.0"
  },
  "optionalDependencies": {
    "@heyputer/puter.js": "^2.6.1"
  }
}
